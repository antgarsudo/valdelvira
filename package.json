{
  "name": "valdelvira-abogados",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/postbuild.mjs",
    "build:demo": "DEPLOY_TARGET=demo npm run build",
