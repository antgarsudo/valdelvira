# Copia este archivo como .env.deploy y rellénalo (no se sube a ningún sitio).
# DEPLOY_HOST: alias SSH (~/.ssh/config) del hosting, o "local" para probar en esta máquina.
DEPLOY_HOST=mi-hosting
DEPLOY_PATH=/home/USUARIO/public_html/valdelvira-abogados
PREVIEW_PATH=/home/USUARIO/public_html/preview.valdelvira-abogados
# Fuera de public_html para que las copias no se puedan descargar por web.
BACKUP_DIR=/home/USUARIO/backups/valdelvira-abogados
